#!/bin/bash
# Run by `yadm bootstrap` (and offered after `yadm clone`). Safe to re-run.
#   SKIP_BREW=1   skip Homebrew install / brew bundle
#   SKIP_ITERM=1  skip pointing iTerm2 at ~/.config/iterm2
set -euo pipefail

log() { echo "[bootstrap] $*"; }

install_brew() {
  if [ "${SKIP_BREW:-}" = 1 ]; then
    log "SKIP_BREW=1, skipping Homebrew"
    return 0
  fi

  if ! command -v brew >/dev/null && [ ! -x /opt/homebrew/bin/brew ]; then
    log "Installing Homebrew"
    local installer
    installer="$(mktemp)"
    curl -fsSL -o "$installer" https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh
    /bin/bash "$installer"
    rm -f "$installer"
  fi
  eval "$(/opt/homebrew/bin/brew shellenv)"

  local reply
  read -r -p "[bootstrap] Run 'brew bundle --global' to install packages from ~/.Brewfile? [y/N] " reply
  if [[ "$reply" =~ ^[Yy]$ ]]; then
    brew bundle --global
  fi
}

install_oh_my_zsh() {
  if [ -d "${HOME}/.oh-my-zsh" ]; then
    log "oh-my-zsh already installed"
    return 0
  fi
  log "Installing oh-my-zsh"
  git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git "${HOME}/.oh-my-zsh"
}

ensure_zshrc_local() {
  local f="${HOME}/.zshrc.local"
  if [ ! -e "$f" ]; then
    (umask 077 && echo "# Machine-local secrets and overrides; not tracked in git." > "$f")
    log "Created $f (add secrets like HOMEASSISTANT_API_KEY here)"
  fi
}

setup_iterm() {
  if [ "${SKIP_ITERM:-}" = 1 ]; then
    log "SKIP_ITERM=1, skipping iTerm2"
    return 0
  fi

  local folder="${HOME}/.config/iterm2"
  if [ "$(defaults read com.googlecode.iterm2 PrefsCustomFolder 2>/dev/null || true)" = "$folder" ]; then
    log "iTerm2 already loads settings from $folder"
    return 0
  fi

  # pgrep missed the running iTerm2 intermittently; ps is reliable.
  # shellcheck disable=SC2009
  if ps -axo comm= | grep '/iTerm.app/Contents/MacOS/iTerm2$' >/dev/null; then
    log "iTerm2 is running. Quit it and re-run 'yadm bootstrap' from Terminal.app to set up iTerm2 settings."
    return 0
  fi

  defaults write com.googlecode.iterm2 PrefsCustomFolder -string "$folder"
  defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool true
  log "iTerm2 will load settings from $folder"
  log "In iTerm2: Settings > General > Settings, set 'Save changes' to Automatically"
}

install_brew
install_oh_my_zsh
ensure_zshrc_local
setup_iterm

log "Done. Open a new shell to pick up changes."
